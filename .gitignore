# --- research data layout (dissertation) ---
# run reports and corpora are tracked; model weights, venvs and third-party clones are not
.venv*/
experiments/**/.venv*/
reports/textsteganalysis/
reports/superseded/
experiments/steganalysis/TextSteganalysis/
experiments/conversation_bench/conversation-steganography/
experiments/conversation_bench/bin/
experiments/**/synsteg_e87605e/
experiments/**/synsteg_683e8cb/
datasets/IMDB*
datasets/steganalysis_datasets/cover.txt
datasets/steganalysis_datasets/stego.txt
datasets/steganalysis_datasets/steganalysis_dataset_2.csv
datasets/textsteganalysis_runs/**/checkpoints/
container.txt
# experiment logs are part of the evidence
!experiments/**/*.log
!reports/*.log
!datasets/textsteganalysis_runs/**/*.log
